	partition 'Tariff Expense Tracker' = m
		mode: import
		source =
				let
				    源 = SharePoint.Files("https://tdworldwide.sharepoint.com/sites/HyveBIProjects/", [ApiVersion = 15]),
				    排序的行 = Table.Sort(源,{{"Date modified", Order.Descending}}),
				    #"Tariff Expense Tracker xlsx_https://tdworldwide sharepoint com/sites/HyveBIProjects/Shared Documents/Tariff/AP/" = 排序的行{[Name="Tariff Expense Tracker.xlsx",#"Folder Path"="https://tdworldwide.sharepoint.com/sites/HyveBIProjects/Shared Documents/Tariff/AP/"]}[Content],
				    #"导入的 Excel 工作簿" = Excel.Workbook(#"Tariff Expense Tracker xlsx_https://tdworldwide sharepoint com/sites/HyveBIProjects/Shared Documents/Tariff/AP/"),
				    Tracker_Sheet = #"导入的 Excel 工作簿"{[Item="Tracker",Kind="Sheet"]}[Data],
				    提升的标题 = Table.PromoteHeaders(Tracker_Sheet, [PromoteAllScalars=true]),
				    #"Removed Other Columns" = Table.SelectColumns(提升的标题,{"Vendor Number ", "Vendor Name", "Customer Number", "Customer Name", "PO Ship-To Location", "PO Number", "PO Line#", "Hyve Part Number ", "MFG Part Number", "PO Ship Term", "HTS Code#(lf) (Invoice Part Level)", "Tariff Part Qty", "PO Base Price", "PO Unit Tariff Rate#(lf)=O2/M2", "PO Unit Tariff Amount", "Tariff Rate (Invoice)", "Tariff Unit Amount (Invoice)#(lf)=R2/L2", "Tariff Total Amount #(lf)(Invoice by Rate)#(lf)=L2*M2*P2", "Tariff Total Amount #(lf)(Actual)#(lf)", "Part COO in CIS", "PO COO", "Shipment COO (Invoice)", "Invoice Vendor Number", "Invoice Vendor Name", "Invoice# ", "Invoice Date", "Entry ID", "SCM Number", "AP Doc#", "Discrepancy (Yes/No)", "Discrepancy Reason#(lf)(select from drop down)", "AP Comments#(lf)Other Reason Code", "Discrepancy Report Date", "Buyer's comments", "Buyer Review Day", "PO Tariff Amount Updated Date", "Discrepancy Close Date", "PO Part Receive Date"}),
				    Custom1 = Table.TransformColumnTypes(#"Removed Other Columns",{{"Vendor Number ", Int64.Type}, {"Vendor Name", type text}, {"Customer Number", Int64.Type}, {"Customer Name", type text}, {"PO Ship-To Location", type text}, {"PO Number", type text}, {"PO Line#", Int64.Type}, {"Hyve Part Number ", type text}, {"MFG Part Number", type any}, {"PO Ship Term", type text}, {"HTS Code#(lf) (Invoice Part Level)", type any}, {"Tariff Part Qty", Int64.Type}, {"PO Base Price", type number}, {"PO Unit Tariff Rate#(lf)=O2/M2", type any}, {"PO Unit Tariff Amount", type any}, {"Tariff Rate (Invoice)", type number}, {"Tariff Unit Amount (Invoice)#(lf)=R2/L2", type number}, {"Tariff Total Amount #(lf)(Invoice by Rate)#(lf)=L2*M2*P2", type number}, {"Tariff Total Amount #(lf)(Actual)#(lf)", type number}, {"Part COO in CIS", type text}, {"PO COO", type text}, {"Shipment COO (Invoice)", type any}, {"Invoice Vendor Number", Int64.Type}, {"Invoice Vendor Name", type text}, {"Invoice# ", type any}, {"Invoice Date", type date}, {"SCM Number", Int64.Type}, {"AP Doc#", Int64.Type}, {"Discrepancy (Yes/No)", type text}, {"Discrepancy Reason#(lf)(select from drop down)", type text}, {"AP Comments#(lf)Other Reason Code", type text}, {"Discrepancy Report Date", type date}, {"Buyer's comments", type text}, {"PO Tariff Amount Updated Date", type date}, {"Discrepancy Close Date", type date}, {"PO Part Receive Date", type date}}),
				    #"Replaced Errors" = Table.ReplaceErrorValues(Custom1, {{"PO Part Receive Date", null}, {"Discrepancy Close Date", null}, {"PO Tariff Amount Updated Date", null}, {"Discrepancy Report Date", null}})
				in
				    #"Replaced Errors"

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

