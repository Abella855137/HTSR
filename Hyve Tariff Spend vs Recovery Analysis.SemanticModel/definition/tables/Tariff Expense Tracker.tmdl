	column cust_code =
			
			VAR _CurrCust = 'Tariff Expense Tracker'[Customer Number]
			RETURN CALCULATE(VALUES(dim_customer[cust_code]), dim_customer[cust_no] = _CurrCust, dim_customer[cust_code] <> BLANK())
		lineageTag: 9e1223e4-6dc6-4733-a65f-e7ac7d495f4c
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column cust_code_v2 =
			
			var code_cnt=CALCULATE(DISTINCTCOUNTNOBLANK('Tariff Expense Tracker'[cust_code]),ALLEXCEPT('Tariff Expense Tracker','Tariff Expense Tracker'[PO Number]))
			return
			IF(code_cnt>=2,"Multiple Cust",CALCULATE(MAX([Cust_code]),ALLEXCEPT('Tariff Expense Tracker','Tariff Expense Tracker'[PO Number])))
		lineageTag: 2bd90144-ab51-4e8d-8b19-c673ad7f518c
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column cust_code_v3 =
			
			var code_cnt=CALCULATE(DISTINCTCOUNTNOBLANK('Tariff Expense Tracker'[cust_code]),ALLEXCEPT('Tariff Expense Tracker','Tariff Expense Tracker'[AP Doc#]))
			return
			IF(code_cnt>=2,"Multiple Cust",CALCULATE(MAX([Cust_code]),ALLEXCEPT('Tariff Expense Tracker','Tariff Expense Tracker'[AP Doc#])))
		lineageTag: 52b7d6e4-0e2a-45bc-b171-c27d26194d7a
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

