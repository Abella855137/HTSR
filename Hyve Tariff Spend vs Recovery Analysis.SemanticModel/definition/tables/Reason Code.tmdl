table 'Reason Code'
	lineageTag: 67f3cb5d-6d19-459e-89c3-86708caa6689

	column 'Part No'
		dataType: string
		lineageTag: 9ba189ac-abbb-4b99-9198-a3427a860b58
		summarizeBy: none
		sourceColumn: Part No

		annotation SummarizationSetBy = Automatic

	column 'Reason Code'
		dataType: string
		lineageTag: 124b60db-285f-4633-a5d2-91cff58ee712
		summarizeBy: none
		sourceColumn: Reason Code

		annotation SummarizationSetBy = Automatic

	column scm_no =
			
			var s1=CALCULATE(MAX('Completed INV Correction'[Transfer to SCM#]),FILTER(ALL('Completed INV Correction'),'Completed INV Correction'[Part#]='Reason Code'[Part No]&&'Completed INV Correction'[Pick Date]='Completed INV Correction'[Last_pick_date]))
			var s2=LOOKUPVALUE('Manual Adjustments'[SCM#],'Manual Adjustments'[Part #],'Reason Code'[Part No])
			var s3= CALCULATE(MAX('Completed INV Correction'[Transfer to SCM#]),FILTER(ALL('Completed INV Correction'),'Completed INV Correction'[Part#]='Reason Code'[Part No]))
			return
			IF(s1<>BLANK(),s1,
			IF(s2<>BLANK(),s2,s3))
		formatString: 0
		lineageTag: 5de3d0a3-3878-44d6-a9b2-491884bceb61
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Total INV correction' = CALCULATE(SUM('Completed INV Correction'[Total Amt]),FILTER(ALL('Completed INV Correction'),'Completed INV Correction'[Part#]='Reason Code'[Part No]))+CALCULATE(SUM('Manual Adjustments'[Total Amount]),FILTER(ALL('Manual Adjustments'),'Reason Code'[scm_no]='Manual Adjustments'[SCM#]))
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: d13f116b-05e2-42bc-85b5-ae215c310f27
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

