	column Year&Month =
			IF(ISBLANK([oh_ship_date]),
			DATE(YEAR([oh_invoice_date]),MONTH([oh_invoice_date]),1),DATE(YEAR([oh_ship_date]),MONTH([oh_ship_date]),1))
		formatString: Long Date
		lineageTag: 2b527a48-1604-4d39-9ae9-85dacc62706c
		summarizeBy: none

		changedProperty = DataType

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column 'Woody Control vs Hyve Controlled' = ```
			
			IF([cust_code_group]="WOODY",
			IF([amazon_part_number]=5081&&CONTAINSSTRING(tt_woody_tariff_recovery_202411052028[description],"tariff"),"Hyve Controlled Part Recovery",
			IF([amazon_part_number]=5081&&CONTAINSSTRING(tt_woody_tariff_recovery_202411052028[item],"tariff"),"Hyve Controlled Part Recovery",
			IF([amazon_part_number]=3065&&CONTAINSSTRING(tt_woody_tariff_recovery_202411052028[description],"tariff"),"Woody Controlled Part Recovery",
			IF([amazon_part_number]=3065&&CONTAINSSTRING(tt_woody_tariff_recovery_202411052028[item],"tariff"),"Woody Controlled Part Recovery",
			IF([amazon_part_number]=5082&&CONTAINSSTRING(tt_woody_tariff_recovery_202411052028[description],"tariff"),"Woody Controlled Part Recovery",
			IF([amazon_part_number]=5082&&CONTAINSSTRING(tt_woody_tariff_recovery_202411052028[item],"tariff"),"Woody Controlled Part Recovery",
			IF([amazon_part_number]=5093&&CONTAINSSTRING(tt_woody_tariff_recovery_202411052028[description],"tariff"),"Woody Controlled Part Recovery",
			IF([amazon_part_number]=5093&&CONTAINSSTRING(tt_woody_tariff_recovery_202411052028[item],"tariff"),"Woody Controlled Part Recovery",
			"Recovery exclusion")))))))),"Non Woody Recovery")
			
			```
		lineageTag: 5875ba9b-3d99-48ef-a1de-bba543daf669
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column cust_program = ```
			
			 VAR S1=LOOKUPVALUE('~order_flag'[internal_cust_program],'~order_flag'[order_no],tt_woody_tariff_recovery_202411052028[order_no_v2])
			 RETURN
			IF([Source.Name]="tt_tariff_alyssa_Tariff recovery feb 2025 dec 2025 update.csv"||[Source.Name]="tt_tariff_alyssa_Tarrif recovery Rack to Jan 2025 update.csv","EVE",
			 IF(S1="WOODY RAMSES PURE","WOODY RAMSES PURE/HYBRID",
			 IF(S1="WOODY RAMSES HYBRID","WOODY RAMSES PURE/HYBRID",
			 S1)))
			```
		lineageTag: 458739b9-1f1f-4395-9f5d-2aad56c8252c
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column intercompany_flag =
			
			VAR S1=LOOKUPVALUE('~order_flag'[cust_flag_s1],'~order_flag'[order_no],tt_woody_tariff_recovery_202411052028[order_no])
			RETURN
			IF(S1="CUST_EXCLUDE","Yes","No")
		lineageTag: 05e08632-a78b-412b-8447-4babd496cba4
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'acc/acp flag' = IF([sku_acc_svr_flag]="Y"||[sku_acp_nw_flag]="Y"||[sku_acp_part_flag]="Y","Y","N")
		lineageTag: cf716fe3-1358-4363-bb26-1187b7a964a1
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Cust_key =
			
			[so_region_no]&"\"&[so_cust_no]
		lineageTag: 4ced79e0-ed78-4134-9de7-5a3ee70d40d3
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column cust_code_group =
			
			VAR S1=LOOKUPVALUE(dim_customer[cust_code_group],dim_customer[Cust_key],tt_woody_tariff_recovery_202411052028[Cust_key])
			RETURN
			IF(S1=BLANK(),IF([Source.Name]="tt_tariff_alyssa_Tariff recovery feb 2025 dec 2025 update.csv"||[Source.Name]="tt_tariff_alyssa_Tarrif recovery Rack to Jan 2025 update.csv","EVE"),S1)
		lineageTag: 7773c08a-4ca5-42c5-84e5-b94d5c93368e
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Excluded_flag =
			
			var order_cnt=CALCULATE(DISTINCTCOUNT(tt_woody_tariff_recovery_202411052028[order_no_v2]),ALLEXCEPT(tt_woody_tariff_recovery_202411052028,tt_woody_tariff_recovery_202411052028[KEY]))
			return
			IF(order_cnt>1&&[intercompany_flag]="INTERCOCOMPANY","Intercompany SO",
			IF([Woody Control vs Hyve Controlled]="Recovery exclusion","Recovery exclusion",
			IF(tt_woody_tariff_recovery_202411052028[asset_tag_check]="N","Same Asset Tag has multiple SO's (Old SO)",BLANK())))
		lineageTag: 52570c4f-51d1-4039-80a8-c03a5cdfb6b6
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

