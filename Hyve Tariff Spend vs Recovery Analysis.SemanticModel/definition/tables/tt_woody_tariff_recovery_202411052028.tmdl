	column asset_tag_check = ```
			VAR LatestPODate = 
			    CALCULATE(
			        MAX(tt_woody_tariff_recovery_202411052028[so_end_user_po_date]),
			        ALLEXCEPT(tt_woody_tariff_recovery_202411052028, tt_woody_tariff_recovery_202411052028[asset_tag])
			    )
			VAR MaxOrderNumber = 
			    CALCULATE(
			        MAX(tt_woody_tariff_recovery_202411052028[order_no]),
			        ALLEXCEPT(tt_woody_tariff_recovery_202411052028, tt_woody_tariff_recovery_202411052028[asset_tag], tt_woody_tariff_recovery_202411052028[so_end_user_po_date])
			    )
			VAR OrdersOnSameDate = 
			    CALCULATE(
			        COUNTROWS(tt_woody_tariff_recovery_202411052028),
			        ALLEXCEPT(tt_woody_tariff_recovery_202411052028, tt_woody_tariff_recovery_202411052028[asset_tag],tt_woody_tariff_recovery_202411052028[so_end_user_po_date])
			    )
			RETURN 
			    IF(LEN(tt_woody_tariff_recovery_202411052028[asset_tag])=0,"Y",
			        IF(
			        tt_woody_tariff_recovery_202411052028[so_end_user_po_date] = LatestPODate && 
			        (OrdersOnSameDate = 1 ||tt_woody_tariff_recovery_202411052028[order_no]= MaxOrderNumber), 
			        "Y", 
			        "N"
			    ))
			```
