		variation Variation
			isDefault
			relationship: 08723d98-e92b-4c93-ab6f-dda8dba8eaf3
			defaultHierarchy: LocalDateTable_c7871f1e-73ad-46e7-8679-dba479022b5c.'Date Hierarchy'

		annotation SummarizationSetBy = Automatic

	partition dwd_hyve_inv_pur_order_detail = m
		mode: import
		source =
				let
				    Source = Odbc.Query("dsn=VERTICA_PROD_US", "SELECT#(lf)    po_no,#(lf)    line_part_no,#(lf)    SUM(line_order_qty) AS total_line_order_qty,#(lf)    SUM(line_received_qty) AS total_line_received_qty,#(lf)    MAX(line_received_date) AS max_line_received_date#(lf)FROM dw_hygbl.dwd_hyve_inv_pur_order_detail#(lf)WHERE line_received_date > '2024-01-01'#(lf)GROUP BY po_no, line_part_no;")
				in
				    Source

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

