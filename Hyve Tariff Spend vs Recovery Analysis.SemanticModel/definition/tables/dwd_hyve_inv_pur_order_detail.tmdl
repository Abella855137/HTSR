		dataType: int64
		formatString: 0
		lineageTag: 28d1c608-ba33-49e8-ac65-8d86f8c6eed2
		summarizeBy: sum
		sourceColumn: total_line_order_qty

		annotation SummarizationSetBy = Automatic

	column total_line_received_qty
		dataType: int64
		formatString: 0
		lineageTag: f8adcb06-f1e9-4cb4-b5dc-25c26edd4f2a
		summarizeBy: sum
		sourceColumn: total_line_received_qty

