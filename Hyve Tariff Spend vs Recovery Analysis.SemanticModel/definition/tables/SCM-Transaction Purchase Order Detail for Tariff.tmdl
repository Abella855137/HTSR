	column tariff_actual_payment = CALCULATE(SUM('Tariff Expense Tracker'[Tariff Total Amount (Actual)]),FILTER(ALL('Tariff Expense Tracker'),'SCM-Transaction Purchase Order Detail for Tariff'[KEY]='Tariff Expense Tracker'[KEY]))
		lineageTag: 81b689e9-29eb-4104-a0db-23d41d563fda
