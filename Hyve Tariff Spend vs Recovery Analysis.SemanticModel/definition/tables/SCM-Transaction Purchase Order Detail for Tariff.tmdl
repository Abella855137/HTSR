	column vend_type = LOOKUPVALUE('Draft Vendor Agreement tracker'[Where do we expect Tariff cost to come from?],'Draft Vendor Agreement tracker'[Vendor #],'SCM-Transaction Purchase Order Detail for Tariff'[vend_no])
		lineageTag: c2cc39a3-8241-4787-a6b3-ddc575e39229
