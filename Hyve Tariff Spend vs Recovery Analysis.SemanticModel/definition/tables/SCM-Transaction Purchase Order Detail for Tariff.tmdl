table 'SCM-Transaction Purchase Order Detail for Tariff'
	lineageTag: cccbe2b4-b473-471b-96b7-5169a8885864

	measure 'SCM Balance' =
			
			SUMX(
			    SUMMARIZE(
			        'SCM-Transaction Purchase Order Detail for Tariff',
			        'SCM-Transaction Purchase Order Detail for Tariff'[scm_no],        // 按订单ID分组
			        "UniquePrice", MAX('SCM-Transaction Purchase Order Detail for Tariff'[scm_pl_gl_balance])  // 取每个订单的价格（假设价格相同）
			    ),
			    [UniquePrice]                     // 对去重后的价格求和
			)
		lineageTag: 95eb67aa-1233-47e1-a57f-3a5fd8b13294

		annotation PBI_FormatHint = {"isGeneralNumber":true}

