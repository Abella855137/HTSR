	column cust_code_v2 = ```
			
			var location=LOOKUPVALUE('~woody_only_locations'[loc_no],'~woody_only_locations'[loc_no],'cust code result per manual order'[loc_no])
			VAR cust_sku_cust_no=IF([cust_sku_cust_no]=554401,"WOODY",IF([cust_sku_cust_no]=902047,"CHATTER",BLANK()))
			var woody_part=IF([acc/acp flag]="Y"&&[woody_cust_part_no]<>BLANK(),"WOODY",BLANK())
			var eve_part=IF([eve_cust_part_no]<>BLANK(),"EVE",BLANK())
			RETURN
			IF([po_cust_code]<>BLANK()||[so_cust_code]<>BLANK()||[Hill He Marked]<>BLANK(),[po_cust_code]&[so_cust_code]&[Hill He Marked],
			IF(location<>BLANK(),"WOODY",
			IF(cust_sku_cust_no<>BLANK(),cust_sku_cust_no,
			IF(woody_part<>BLANK(),woody_part,
			IF(eve_part<>BLANK(),eve_part,BLANK())))))
			
