	partition 'Data Dictionary' = calculated
		mode: import
		source = ```
				
				VAR _Columns = 
				        SELECTCOLUMNS(
				            FILTER(
				                INFO.VIEW.COLUMNS(),
				                [Table] <> "Data Dictionary" && NOT [IsHidden]
				            ),
				            "Type", "Column",
				            "Name", [Name],
				            "Description", [Description],
				            "Location", [Table],
				            "Expression", [Expression]
				        )
				VAR _Measures = 
				        SELECTCOLUMNS(
				            FILTER(
				                INFO.VIEW.MEASURES(),
				                [Table] <> "Data Dictionary" && NOT [IsHidden]
				            ),
				            "Type", "Measure",
				            "Name", [Name],
				            "Description", [Description],
				            "Location", [Table],
				            "Expression", [Expression]
				        )
				VAR _Tables = 
				        SELECTCOLUMNS(
				            FILTER(
				                INFO.VIEW.TABLES(),
				                [Name] <> "Data Dictionary" && NOT [IsHidden]
				            ),
				            "Type", "Table",
				            "Name", [Name],
				            "Description", [Description],
				            "Location", BLANK(),
				            "Expression", [Expression]
				        )
				VAR _Relationships = 
				        SELECTCOLUMNS(
				            INFO.VIEW.RELATIONSHIPS(),
				            "Type", "Relationship",
				            "Name", [Relationship],
				            "Description", [CrossFilteringBehavior],
				            "Location", BLANK(),
				            "Expression", [Relationship]
				        )
				RETURN UNION(_Columns, _Measures, _Tables, _Relationships)
				```

	annotation PBI_Id = f8a4adacc22940159d35c8a70a4c275b

