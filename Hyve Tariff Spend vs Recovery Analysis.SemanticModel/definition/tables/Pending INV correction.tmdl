				    提升的标题 = Table.PromoteHeaders(#"Pending INC Correction_Sheet", [PromoteAllScalars=true]),
				    更改的类型 = Table.TransformColumnTypes(提升的标题,{{"sku_no", Int64.Type}, {"sku_vend_no", Int64.Type}, {"part_no", type text}, {"scm_no", Int64.Type}, {"scm_name", type text}, {" Total INV Correction ", type number}, {"Impacted Qty", Int64.Type}, {" Unit over accural Amt ", type number}})
				in
