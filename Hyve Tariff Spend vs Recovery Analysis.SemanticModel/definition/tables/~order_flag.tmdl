	partition ~order_flag = m
		mode: import
		source =
				let
				    Source = Odbc.Query("dsn=VERTICA_PROD_US", "select /*+label('From PBI model/Dataflow Hyve Finance/Hyve Tariff Spend vs Recovery Analysis by alyssa.lei')*/#(lf)COUNT(*) OVER(PARTITION BY - 999) AS row_cnt,#(lf)region_no,order_type, order_no, order_cust_name,cust_flag_s1,cust_flag_s1_source, icpvpo_region_no, icpvpo_order_type, icpvpo_order_no, icpvpo_loc_no, icpvpo_vend_name,#(lf)case when upper(order_cust_name) like '%HYVE%' and upper(icpvpo_vend_name) like '%HYVE%' then 'INTERCOCOMPANY'#(lf)when upper(order_cust_name) like '%HYVE%' and icpvpo_order_no is null then 'SAGE'#(lf)else 'NA' end as 'intercompany_flag',#(lf)first_level_prod_line, internal_cust_program, order_top_line_sys_type_desc,#(lf)case when oh_ship_to_state = 'TN' and internal_cust_program like '%SPARE%' and region_no = 10001 then 'JANUS'#(lf)else 'NON_JANUS' end as 'so_janus_flag'#(lf)from#(lf)dm_hygbl.dm_hyve_biz_perf_rawdata_mi#(lf)where order_type = 1#(lf)#(lf)#(lf)")
				in
				    Source

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

