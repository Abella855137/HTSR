	column total_gl_amt_order_level = CALCULATE(SUM([gl_amt_no_duplicate]),ALLEXCEPT(dwd_hyve_finance_ap_tariff_mi,dwd_hyve_finance_ap_tariff_mi[order_no],dwd_hyve_finance_ap_tariff_mi[Year&Month]))
		lineageTag: b43bf773-c251-4061-969e-e081bbe15238
