	partition dwd_hyve_finance_ap_tariff_mi = m
		mode: import
		source =
				let
				    Source = Odbc.Query("dsn=VERTICA_PROD_US", "SELECT /*+label('From PBI model/Dataflow Hyve Finance/Hyve Tariff Spend vs Recovery Analysis by alyssa.lei')*/ #(lf)    a.*,#(lf)    b.to_loc_no#(lf)FROM #(lf)    dw_hygbl.dwd_hyve_finance_ap_tariff_mi AS a#(lf)LEFT JOIN #(lf)    dw_hygbl.dwd_hyve_pur_related_order_header AS b#(lf)ON #(lf)a.region_no = b.region_no#(lf)and a.order_type=b.order_type#(lf)and a.order_no=b.order_no")
				in
				    Source

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

