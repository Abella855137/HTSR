			var result2=LOOKUPVALUE('cust code result per manual order'[intercomp_vend_flag],'cust code result per manual order'[doc_no],dwd_hyve_finance_ap_tariff_mi[order_no])
			var result3=IF(ISBLANK(result1),result2,result1)
			RETURN
