	column cust_program_final =
			
			var _ExcludeBSIC = {"TBD", "Unable", "Smaller amt","MFG"}
			var cust_code = IF(SUMX(_ExcludeBSIC,IF(CONTAINSSTRING(dwd_hyve_finance_ap_tariff_mi[cust_code_v2], [Value]),1,0)) > 0, BLANK(), dwd_hyve_finance_ap_tariff_mi[cust_code_v2])
			RETURN
			COALESCE([program_by_location],[INV_Program],cust_code,"Unassigned")
		lineageTag: accce534-ea96-4fd1-9372-9c98fdd42af1
		summarizeBy: none

