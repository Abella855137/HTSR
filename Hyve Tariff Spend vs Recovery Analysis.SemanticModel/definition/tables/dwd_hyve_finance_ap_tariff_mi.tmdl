	column KEY = [je_no]&"\"&[je_line_no]&"\"&[sku_no]
		lineageTag: b54fe542-767b-40ba-b6f4-39b60dbef5c1
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column order_v2 =
			
			var manual_order=LOOKUPVALUE(BSIC_manual_result[Order],BSIC_manual_result[KEY],dwd_hyve_finance_ap_tariff_mi[KEY])
			return
			IF(ISBLANK([order_no]),manual_order,[order_no])
		lineageTag: 1ad7eab8-ac96-4e21-9797-771b9c0139a7
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column cust_code_v2 =
			
			var cust_code_from_order=LOOKUPVALUE(BSIC_manual_result[cust_code_v2],BSIC_manual_result[KEY],dwd_hyve_finance_ap_tariff_mi[KEY])
			var result1=IF(ISBLANK([po_cust_code]),cust_code_from_order,[po_cust_code])
			var result2=IF(result1="WOODY_SPARE","WOODY",result1)
			var result3=IF(LOOKUPVALUE('Hyve controlled invoices'[KEY],'Hyve controlled invoices'[KEY],dwd_hyve_finance_ap_tariff_mi[KEY])=BLANK(),BLANK(),"Woody")
			var cust_code_per_ap_reference=LOOKUPVALUE('reference AP VEND DOC'[cust_code_v2],'reference AP VEND DOC'[KEY],dwd_hyve_finance_ap_tariff_mi[KEY_VEND_DOC])
			var cust_code_per_ap_tracker_S1=IF([order_no]=BLANK(),LOOKUPVALUE('Tariff Expense Tracker'[cust_code_v3],'Tariff Expense Tracker'[AP Doc#],dwd_hyve_finance_ap_tariff_mi[doc_no]),BLANK())
			var cust_code_per_ap_tracker_S2=IF([order_no]=BLANK(),LOOKUPVALUE('Tariff Expense Tracker'[cust_code_v4],'Tariff Expense Tracker'[Invoice# ],dwd_hyve_finance_ap_tariff_mi[vend_inv_no]),BLANK())
			var cust_code_per_ap_tracker_FINAL= IF([order_no]=BLANK(),IF(cust_code_per_ap_tracker_S1<>BLANK(),cust_code_per_ap_tracker_S1,cust_code_per_ap_tracker_S2),LOOKUPVALUE('Tariff Expense Tracker'[cust_code_v2],'Tariff Expense Tracker'[PO Number],dwd_hyve_finance_ap_tariff_mi[order_no]))
			RETURN
			IF(result3<>BLANK(),result3,
			IF(cust_code_per_ap_reference<>BLANK(),cust_code_per_ap_reference,
			IF(result2<>BLANK(),result2,
			IF(cust_code_per_ap_tracker_FINAL<>BLANK(),cust_code_per_ap_tracker_FINAL,"Unassigned"))))
		lineageTag: 38669f29-50e9-4f9c-84a7-498ddfc3ac77
		summarizeBy: none

