	column line_total_cost = [po_cost]*[rec_qty]
		lineageTag: 2c9ea707-1b0a-4713-94c1-5548475543d8
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column COO_contains_CN_sku_cnt = CALCULATE(SUM(dwd_hyve_finance_ap_tariff_mi[COO_flag]),ALLEXCEPT(dwd_hyve_finance_ap_tariff_mi,dwd_hyve_finance_ap_tariff_mi[order_no],dwd_hyve_finance_ap_tariff_mi[dt_month]))
		formatString: 0
		lineageTag: c1c690db-679a-4f6e-a801-532867cc0ef4
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column percentage_of_total_base_cost = ```
			
			var total_cost_coo_china=CALCULATE(SUM([line_total_cost]),ALLEXCEPT(dwd_hyve_finance_ap_tariff_mi,dwd_hyve_finance_ap_tariff_mi[order_no],dwd_hyve_finance_ap_tariff_mi[Year&Month]),dwd_hyve_finance_ap_tariff_mi[COO_flag]=1)
			var total_cost_all_part=CALCULATE(SUM([line_total_cost]),ALLEXCEPT(dwd_hyve_finance_ap_tariff_mi,dwd_hyve_finance_ap_tariff_mi[order_no],dwd_hyve_finance_ap_tariff_mi[Year&Month]))
			return
			IF([line_total_cost]=0,0,
			IF([COO_contains_CN_sku_cnt]=0,
			[line_total_cost]/total_cost_all_part,
			IF([COO_flag]=1,[line_total_cost]/total_cost_coo_china,BLANK())))
			
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 281daa80-a039-4441-9af1-25109d80121e
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column current_sku_tariff_pocv% = ```
			
			VAR S0=LOOKUPVALUE(dm_hyve_po_receiving_tariff_report_mi[TARIFF_V2],dm_hyve_po_receiving_tariff_report_mi[KEY],dwd_hyve_finance_ap_tariff_mi[KEY_POCV])
			var s1=LOOKUPVALUE(current_system_tariff_rate[total tariff],current_system_tariff_rate[sku_no],dwd_hyve_finance_ap_tariff_mi[sku_no])
			var s2=IF([COO_flag]=1&&[gl_trans_date]<DATE(2025,1,1),1,0)
			return
			IF(S0<>BLANK(),S0,
			IF(s2=1,
			IF(s1=0.7||s1=0.45,0.25,
			IF(s1=0.525||s1=0.275,0.075,
			IF(s1=0.075,0.075,
			IF(s1=0.25,0.25,0.25)))),S1))
			
			
			```
		lineageTag: c5d2a563-289f-4ff5-9f61-9a94b4c07a20
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column 'GL Cost attribution_s1' =
			
			///PO only hasn 1 SKU
			var SKU_cnt_order_level=CALCULATE(DISTINCTCOUNT([KEY_POCV]),ALLEXCEPT(dwd_hyve_finance_ap_tariff_mi,dwd_hyve_finance_ap_tariff_mi[order_no]))
			return
			IF(SKU_cnt_order_level=1,[total_gl_amt_order_level],BLANK())
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 1f98ca4c-e92b-47c6-8232-c2c8eededc89
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'GL Cost attribution_s2' =
			
			///all SKU under the PO doesn't contains COO China
			var SKU_cnt_order_level=CALCULATE(COUNT([KEY_POCV]),ALLEXCEPT(dwd_hyve_finance_ap_tariff_mi,dwd_hyve_finance_ap_tariff_mi[order_no]))
			return
			IF([COO_contains_CN_sku_cnt]=0&&SKU_cnt_order_level>1,[total_gl_amt_order_level]*[percentage_of_total_base_cost],BLANK())
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 3d363852-0a88-47c4-a162-2fb4d0748f47
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'GL Cost attribution_s3' =
			
			///some SKU contain COO China
			IF([GL Cost attribution_s1]=BLANK()&&[GL Cost attribution_s2]=BLANK(),
			IF([current_sku_tariff_pocv%]<>BLANK()&&[COO_flag]=1,[line_total_cost]*[current_sku_tariff_pocv%],
			IF([current_sku_tariff_pocv%]=BLANK()&&[COO_flag]=1,[line_total_cost]*0.25,0)))
		lineageTag: bd4406fb-206e-4520-ba49-7bf24509d33b
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column 'GL Cost attribution_s4' =
			
			VAR S1=CALCULATE(SUM([GL Cost attribution_s3]),ALLEXCEPT(dwd_hyve_finance_ap_tariff_mi,dwd_hyve_finance_ap_tariff_mi[order_v2],dwd_hyve_finance_ap_tariff_mi[dt_month]))
			VAR S2=[total_gl_amt_order_level]-S1
			RETURN
			IF([line_total_cost]=0,0,
			IF(S2=0,[GL Cost attribution_s3],
			[total_gl_amt_order_level]*[percentage_of_total_base_cost]))
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: 5da3dfac-f50c-4c3e-80ba-8772afba08b7
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'GL Cost attribution_final' =
			
			VAR S0=CALCULATE(COUNT(dwd_hyve_finance_ap_tariff_mi[KEY_POCV]),ALLEXCEPT(dwd_hyve_finance_ap_tariff_mi,dwd_hyve_finance_ap_tariff_mi[order_no]))
			var s1=CALCULATE(SUM(dwd_hyve_finance_ap_tariff_mi[GL Cost attribution_s5]),ALLEXCEPT(dwd_hyve_finance_ap_tariff_mi,dwd_hyve_finance_ap_tariff_mi[order_no]))
			var s2=CALCULATE(SUM(dwd_hyve_finance_ap_tariff_mi[COO_flag]),ALLEXCEPT(dwd_hyve_finance_ap_tariff_mi,dwd_hyve_finance_ap_tariff_mi[order_no]))
			RETURN
			IF([order_no]=BLANK(),[gl_amt_no_duplicate],
			IF(s1=BLANK(),
			IF(dwd_hyve_finance_ap_tariff_mi[COO_flag]=1,[total_gl_amt_order_level]/dwd_hyve_finance_ap_tariff_mi[COO_contains_CN_sku_cnt],
			IF(s2=0,
			[total_gl_amt_order_level]/S0)),dwd_hyve_finance_ap_tariff_mi[GL Cost attribution_s5]))
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: 19943516-4f0e-4bfa-bfdd-72102c6d808d
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	column 'ACC/ACP Type' =
			IF([acc_svr_flag]="Y","ACC",
			IF([acp_nw_flag]="Y","NW",
			IF([acp_part_flag]="Y","ACP","Non ACC/ACP")))
		lineageTag: 23640536-4d1d-4611-b6f8-28a2e5832f7c
