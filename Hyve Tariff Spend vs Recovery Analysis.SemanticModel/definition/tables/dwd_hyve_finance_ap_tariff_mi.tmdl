		annotation SummarizationSetBy = Automatic

	column SKU_COO_S1 = ```
			
			var s1=LOOKUPVALUE('Top SKU for Tariff'[updated_coo],'Top SKU for Tariff'[sku_no],dwd_hyve_finance_ap_tariff_mi[sku_no])
			var s2=CALCULATE(MAX(dwd_hyve_finance_ap_tariff_mi[cis_sku_coo]),ALLEXCEPT(dwd_hyve_finance_ap_tariff_mi,dwd_hyve_finance_ap_tariff_mi[KEY_POCV]))
			var s3=LOOKUPVALUE(dim_part[sku_coo],dim_part[KEY],dwd_hyve_finance_ap_tariff_mi[KEY_SKU])
			RETURN
			IF(LEN(s1)>1,s1,
			IF(LEN(s2)>1,s2,
			IF(LEN(s3)>1,s3,
			s1&s2&s3)))
			
			```
