	column to_loc_no
		dataType: int64
		formatString: 0
		lineageTag: 5ea78d39-e5b0-4b3a-85d3-4258d0f92698
		summarizeBy: sum
		sourceColumn: to_loc_no

		annotation SummarizationSetBy = Automatic

	column INV_Program = ```
			
			VAR CUST=LOOKUPVALUE('~INV location_mapping'[Cust],'~INV location_mapping'[Location],[to_loc_no])
			VAR PROGRAM=LOOKUPVALUE('~INV location_mapping'[Cust program],'~INV location_mapping'[Location],[to_loc_no])
			var woody=IF(CUST="Woody"&&[cust_code_v2]="WOODY",PROGRAM,BLANK())
			var eve=IF(CUST="Eve"&&[cust_code_v2]="EVE","EVE",BLANK())
			var _all_cust=IF(CUST="All",PROGRAM,BLANK())
			RETURN
			IF(woody<>BLANK(),woody,
			IF(eve<>BLANK(),eve,
			_all_cust))
			
			```
		lineageTag: 0c1ae25c-8bb2-4edd-b0f9-0a0b0afb60aa
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column program_by_location =
			
			VAR _tt = LOOKUPVALUE('~Hill''s location mapping'[program_name], '~Hill''s location mapping'[loc_no], dwd_hyve_finance_ap_tariff_mi[to_loc_no])
			VAR CUST=LOOKUPVALUE('~Hill''s location mapping'[Cust], '~Hill''s location mapping'[loc_no], dwd_hyve_finance_ap_tariff_mi[to_loc_no])
			VAR _Result = SWITCH(TRUE()
			                ,CUST="WOODY"&&[cust_code_v2]="WOODY",_tt
			                ,CUST="ALL"&&_tt<>BLANK(),_tt,BLANK()
			)
			RETURN _Result
		lineageTag: 6a9fe94a-f463-41dc-8fbc-d828f43f0b57
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'GL Cost attribution_s5' = ```
			
			IF([GL Cost attribution_s2]<>BLANK(),[GL Cost attribution_s2],  
			IF([GL Cost attribution_s4]<>BLANK(),[GL Cost attribution_s4],BLANK()))
			```
		lineageTag: 48319b29-c865-48bb-b987-6c65d8339620
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

